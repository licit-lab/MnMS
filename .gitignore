# Keep the following list of files/directories to exclude from version control as small as possible.
# Only patterns relevant for the current project should appear in this list.

# Python bytecode directories
__pycache__/

# Temporary/cache directories and files created by miscellaneous development tools
/.cache
/.pytest_cache/
/.coverage

# FIXME Running the tests result to a log file generated in the root directory.
# It would be better to isolate these logs in a dedicated directory,
# and also to avoid that each test overwrites the same log file.
/log.txt

# Directory for test coverage reports
/coverage_report/

# Output directory for Python distribution files (wheels & source distributions)
/dist/

# Ouput directory for documentation generated by MkDocs
/site/

# Python virtual environments (usual names), expected only in the root directory
/env/
/venv/
/.env/
/.venv/
/env[_\-]*/
/venv[_\-]*/
/.env[_\-]*/
/.venv[_\-]*/

# MacOS files
.DS_Store

# IDE files
.vscode
.idea
.ipynb_checkpoints
